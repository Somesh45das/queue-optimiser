# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Windows batch files should always use CRLF
*.bat text eol=crlf

# Python files should use LF
*.py text eol=lf

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# HTML/CSS/JS files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.pkl binary
*.db binary
*.pyc binary
